{
  "id": 121,
  "className": "Solution",
  "methodName": "maxProfit",
  "params": [
    {
      "name": "prices",
      "type": "int[]"
    }
  ],
  "returnType": "int",
  "kind": "function",
  "comparator": "exact",
  "timeLimitMs": 2000,
  "memoryLimitMb": 256,
  "examples": [
    {
      "input": {
        "prices": [
          7,
          1,
          5,
          3,
          6,
          4
        ]
      },
      "output": 5,
      "explanation": "Buy on day 2 (price = 1) and sell on day 5 (price = 6), profit = 6-1 = 5."
    },
    {
      "input": {
        "prices": [
          7,
          6,
          4,
          3,
          1
        ]
      },
      "output": 0,
      "explanation": "In this case, no transactions are done and max profit = 0."
    }
  ],
  "constraints": [
    "1 <= prices.length <= 10^5",
    "0 <= prices[i] <= 10^4"
  ]
}