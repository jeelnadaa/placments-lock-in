{
  "id": 56,
  "className": "Solution",
  "methodName": "merge",
  "params": [
    {
      "name": "intervals",
      "type": "int[][]"
    }
  ],
  "returnType": "int[][]",
  "kind": "function",
  "comparator": "exact",
  "timeLimitMs": 2000,
  "memoryLimitMb": 256,
  "examples": [
    {
      "input": {
        "intervals": [
          [
            1,
            3
          ],
          [
            2,
            6
          ],
          [
            8,
            10
          ],
          [
            15,
            18
          ]
        ]
      },
      "output": [
        [
          1,
          6
        ],
        [
          8,
          10
        ],
        [
          15,
          18
        ]
      ],
      "explanation": "Since intervals [1,3] and [2,6] overlap, merge them into [1,6]."
    },
    {
      "input": {
        "intervals": [
          [
            1,
            4
          ],
          [
            4,
            5
          ]
        ]
      },
      "output": [
        [
          1,
          5
        ]
      ],
      "explanation": "Intervals [1,4] and [4,5] are considered overlapping."
    }
  ],
  "constraints": [
    "1 <= intervals.length <= 10^4",
    "intervals[i].length == 2",
    "0 <= start_i <= end_i <= 10^4"
  ]
